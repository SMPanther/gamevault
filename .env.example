# Copy to .env (never commit .env). Create React App reads REACT_APP_* at build time.

# --- Required: Supabase ---
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON=your_anon_key_here

# Optional alias (if you prefer this name):
# REACT_APP_SUPABASE_ANON_KEY=same_as_anon_above

# --- Registration OTP emails (EmailJS) ---
REACT_APP_EMAILJS_SERVICE=your_service_id
REACT_APP_EMAILJS_TEMPLATE=your_template_id
REACT_APP_EMAILJS_KEY=your_public_key

# --- AI assistant (Groq) ---
REACT_APP_GROQ_KEY=
